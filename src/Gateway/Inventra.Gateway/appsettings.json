{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "ReverseProxy": {
    "Routes": {
      "tenancy": {
        "ClusterId": "tenancy",
        "AuthorizationPolicy": "signed-in",
        "Match": {
          "Path": "/api/tenancy/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/tenancy"
          }
        ]
      },
      "access": {
        "ClusterId": "access",
        "AuthorizationPolicy": "signed-in",
        "Match": {
          "Path": "/api/access/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/access"
          }
        ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "signed-in",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ]
      },
      "assets": {
        "ClusterId": "assets",
        "AuthorizationPolicy": "signed-in",
        "Match": {
          "Path": "/api/assets/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/assets"
          }
        ]
      },
      "documents": {
        "ClusterId": "documents",
        "AuthorizationPolicy": "signed-in",
        "Match": {
          "Path": "/api/documents/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/documents"
          }
        ]
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "primary": {
            "Address": "https+http://tenancy"
          }
        }
      },
      "access": {
        "Destinations": {
          "primary": {
            "Address": "https+http://access"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "https+http://catalog"
          }
        }
      },
      "assets": {
        "Destinations": {
          "primary": {
            "Address": "https+http://assets"
          }
        }
      },
      "documents": {
        "Destinations": {
          "primary": {
            "Address": "https+http://documents"
          }
        }
      }
    }
  }
}
