{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "ReverseProxy": {
    "Routes": {
      "tenancy": {
        "ClusterId": "tenancy",
        "AuthorizationPolicy": "signed-in",
        "Match": { "Path": "/api/tenancy/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/tenancy" } ]
      },
      "access": {
        "ClusterId": "access",
        "AuthorizationPolicy": "signed-in",
        "Match": { "Path": "/api/access/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/access" } ]
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "primary": { "Address": "https+http://tenancy" }
        }
      },
      "access": {
        "Destinations": {
          "primary": { "Address": "https+http://access" }
        }
      }
    }
  }
}
