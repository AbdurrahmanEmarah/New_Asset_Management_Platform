{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Wolverine": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MaxPoolSize": 10,
    "MigrateOnStartup": false,
    "RowSecurityRole": ""
  },
  "Auth": {
    "Platform": {
      "Audience": "inventra-api"
    },
    "Tenant": {
      "Audience": "inventra-api"
    }
  },
  "Access": {
    "WebAppUrl": "http://localhost:5174",
    "RequireVerifiedEmail": true
  },
  "Identity": {
    "Keycloak": {
      "Realm": "inventra",
      "ClientId": "access-service"
    }
  }
}
