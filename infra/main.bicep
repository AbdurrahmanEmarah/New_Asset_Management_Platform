// Inventra: one Azure environment (staging first) in one resource group.
//
//   Internet ─► gateway (Container App, public HTTPS) ─► services (internal Container Apps)
//                                                         │
//          VNet ┌─────────────────────────────────────────┼──────────────────────────────┐
//               │ apps subnet: Container Apps environment  ▼                              │
//               │ postgres subnet: PostgreSQL Flexible Server (private access)            │
//               │ private-endpoints subnet: Key Vault, Blob Storage                       │
//               └──────────────────────────────────────────────────────────────────────────┘
//          Public but Entra-only: Container Registry (Basic), Service Bus (Standard).
//          Web apps: Static Web Apps (Free), one per entry in services.json "webApps".
//
// The deploy workflow runs this template three times (see scripts/deploy/deploy.sh):
//   1. infra  (deployJobs=false, deployApps=false): network, data stores, registry, Key Vault, environment
//   2. jobs   (deployJobs=true): database bootstrap and migration jobs, which the workflow then runs
//   3. apps   (deployApps=true): gateway and services on the new image tag
// Incremental mode leaves resources from earlier runs alone, so an earlier stage never removes apps.
//
// Note: no parameter is called "environment", because that would hide the environment() function.

targetScope = 'resourceGroup'

@description('Azure region. Defaults to the resource group\'s region.')
param location string = resourceGroup().location

@minLength(2)
@maxLength(8)
@description('Short lowercase prefix for every resource name: letters and digits only, e.g. "inventra".')
param namePrefix string

@allowed(['staging', 'production'])
param envName string = 'staging'

@description('Image tag to deploy, normally the commit SHA.')
param imageTag string = ''

param deployJobs bool = false
param deployApps bool = false

@description('Issuer URL for platform staff tokens (Entra External ID). Required once apps are deployed.')
param platformAuthority string = ''

@description('Issuer URL for client user tokens. Optional until the client realm exists.')
param tenantAuthority string = ''

@description('Audience of platform tokens. Keycloak: "inventra-api". Entra: the platform API app registration\'s client ID.')
param platformAudience string = 'inventra-api'

@description('Audience of client user tokens. Entra External ID: the client API app registration\'s client ID.')
param tenantAudience string = 'inventra-api'

@description('Browser origins allowed to call the gateway, e.g. the admin console\'s address.')
param corsOrigins array = []

@secure()
@description('Passwords to store in Key Vault, as { secretName: value }. Generated by scripts/deploy/new-secrets.sh only for secrets that do not exist yet; empty otherwise.')
param newSecrets object = {}

param postgresAdminLogin string = 'inventra_admin'

@allowed(['westeurope', 'centralus', 'eastus2', 'westus2', 'eastasia'])
@description('Region for the Static Web Apps (only offered in a few regions; the content is served from a global CDN anyway).')
param staticWebAppLocation string = 'westeurope'

var isProd = envName == 'production'
var envShort = isProd ? 'prd' : 'stg'
var base = '${namePrefix}-${envShort}'
var suffix = take(uniqueString(resourceGroup().id), 6)
var tags = {
  app: 'inventra'
  environment: envName
}

var manifest = loadJsonContent('services.json')
var services = manifest.services
var webApps = manifest.webApps
var gatewayName = manifest.gateway.name

// Per-environment sizes. Staging is as cheap as Azure allows; costs are monthly estimates in USD.
var sizes = {
  staging: {
    postgresSku: 'Standard_B1ms' // Burstable, about $13 + $4 for 32 GiB storage
    postgresTier: 'Burstable'
    postgresStorageGB: 32
    postgresHa: false
    storageSku: 'Standard_LRS'
    logDailyQuotaGb: 1 // Caps Log Analytics at about $70/month even in a log storm; normally a few dollars.
    minReplicas: 0 // Scale to zero when idle; the first request after a pause takes a few seconds.
    maxReplicas: 2
    keyVaultSoftDeleteDays: 7
    keyVaultPurgeProtection: false
  }
  production: {
    postgresSku: 'Standard_D2ds_v5'
    postgresTier: 'GeneralPurpose'
    postgresStorageGB: 128
    postgresHa: true
    storageSku: 'Standard_ZRS'
    logDailyQuotaGb: -1
    minReplicas: 1
    maxReplicas: 10
    keyVaultSoftDeleteDays: 90
    keyVaultPurgeProtection: true
  }
}
var size = sizes[envName]

// ── Foundation ────────────────────────────────────────────────────────────────────────────────────────

module network 'modules/network.bicep' = {
  name: 'network'
  params: { location: location, namePrefix: base, tags: tags }
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: { location: location, namePrefix: base, tags: tags, dailyQuotaGb: size.logDailyQuotaGb }
}

module registry 'modules/registry.bicep' = {
  name: 'registry'
  params: { location: location, name: '${namePrefix}${envShort}acr${suffix}', tags: tags }
}

var keyVaultName = take('${base}-kv-${suffix}', 24)

module keyVault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  params: {
    location: location
    name: keyVaultName
    tags: tags
    privateEndpointSubnetId: network.outputs.privateEndpointSubnetId
    privateDnsZoneId: network.outputs.keyVaultZoneId
    softDeleteRetentionInDays: size.keyVaultSoftDeleteDays
    enablePurgeProtection: size.keyVaultPurgeProtection
    newSecrets: newSecrets
  }
}

// Used only for getSecret(); declared after the module above creates it.
resource vault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: keyVaultName
}

// ── Data and messaging ────────────────────────────────────────────────────────────────────────────────

var secretNames = {
  postgresAdmin: 'pg-admin-password'
  runtimePassword: map(services, s => 'pg-${s.name}-runtime-password')
  migratorPassword: map(services, s => 'pg-${s.name}-migrator-password')
  runtimeConnection: map(services, s => 'cs-${s.name}-runtime')
}
var logins = {
  runtime: map(services, s => 'svc_${replace(s.name, '-', '_')}')
  migrator: map(services, s => 'svc_${replace(s.name, '-', '_')}_migrator')
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    location: location
    name: '${base}-pg-${suffix}'
    tags: tags
    subnetId: network.outputs.postgresSubnetId
    privateDnsZoneId: network.outputs.postgresZoneId
    administratorLogin: postgresAdminLogin
    administratorPassword: vault.getSecret(secretNames.postgresAdmin)
    databases: map(services, s => s.database)
    skuName: size.postgresSku
    skuTier: size.postgresTier
    storageSizeGB: size.postgresStorageGB
    postgresVersion: '17' // Local development uses 18; Azure Flexible Server's newest generally available version is 17.
    highAvailability: size.postgresHa
  }
  dependsOn: [keyVault] // The admin password secret must exist before ARM reads it.
}

module runtimeConnections 'modules/db-connection-secret.bicep' = [
  for (s, i) in services: {
    name: 'cs-${s.name}'
    params: {
      keyVaultName: keyVaultName
      secretName: secretNames.runtimeConnection[i]
      host: postgres.outputs.fqdn
      database: s.database
      username: logins.runtime[i]
      password: vault.getSecret(secretNames.runtimePassword[i])
    }
    dependsOn: [keyVault]
  }
]

module serviceBus 'modules/servicebus.bicep' = {
  name: 'servicebus'
  params: { location: location, name: '${base}-sb-${suffix}', tags: tags }
}

module storage 'modules/storage.bicep' = {
  name: 'storage'
  params: {
    location: location
    name: take('${namePrefix}${envShort}st${suffix}', 24)
    tags: tags
    privateEndpointSubnetId: network.outputs.privateEndpointSubnetId
    privateDnsZoneId: network.outputs.blobZoneId
    skuName: size.storageSku
  }
}

// ── Web apps ──────────────────────────────────────────────────────────────────────────────────────────

module staticSites 'modules/static-site.bicep' = {
  name: 'web-apps'
  params: { location: staticWebAppLocation, namePrefix: base, tags: tags, apps: map(webApps, w => w.name) }
}

// The gateway accepts browser calls from its own web apps plus any extra origins (custom domains).
var allCorsOrigins = union(corsOrigins, map(staticSites.outputs.sites, s => s.url))

// ── Compute ───────────────────────────────────────────────────────────────────────────────────────────

module containerEnv 'modules/containerapps-env.bicep' = {
  name: 'containerapps-env'
  params: {
    location: location
    namePrefix: base
    tags: tags
    subnetId: network.outputs.appsSubnetId
    workspaceName: monitoring.outputs.workspaceName
    appInsightsName: monitoring.outputs.appInsightsName
  }
}

var registryServer = registry.outputs.loginServer
var appName = map(services, s => take('${base}-${s.name}', 32))
var gatewayAppName = take('${base}-${gatewayName}', 32)
var aspnetEnvironment = isProd ? 'Production' : 'Staging'
var secretUrl = '${keyVault.outputs.uri}secrets/'

// Identities exist from stage 1, so their role assignments have replicated before anything pulls or reads.
module serviceIdentities 'modules/app-identity.bicep' = [
  for (s, i) in services: {
    name: 'id-${s.name}'
    params: {
      location: location
      name: '${base}-${s.name}-id'
      tags: tags
      registryName: registry.outputs.name
      keyVaultName: keyVaultName
      secretNames: [runtimeConnections[i].outputs.name]
      serviceBusNamespaceName: serviceBus.outputs.name
      storageAccountName: s.usesBlobStorage ? storage.outputs.name : ''
    }
  }
]

module gatewayIdentity 'modules/app-identity.bicep' = {
  name: 'id-${gatewayName}'
  params: {
    location: location
    name: '${base}-${gatewayName}-id'
    tags: tags
    registryName: registry.outputs.name
    keyVaultName: keyVaultName
    secretNames: []
  }
}

// The bootstrap job is the only thing that ever signs in as the PostgreSQL admin.
module bootstrapIdentity 'modules/app-identity.bicep' = {
  name: 'id-db-bootstrap'
  params: {
    location: location
    name: '${base}-db-bootstrap-id'
    tags: tags
    registryName: registry.outputs.name
    keyVaultName: keyVaultName
    secretNames: concat([secretNames.postgresAdmin], secretNames.runtimePassword, secretNames.migratorPassword)
  }
  dependsOn: [keyVault]
}

module migratorIdentities 'modules/app-identity.bicep' = [
  for (s, i) in services: {
    name: 'id-migrate-${s.name}'
    params: {
      location: location
      name: '${base}-${s.name}-migrator-id'
      tags: tags
      registryName: registry.outputs.name
      keyVaultName: keyVaultName
      secretNames: [secretNames.migratorPassword[i]]
    }
    dependsOn: [keyVault]
  }
]

// ── Stage 2: database jobs ────────────────────────────────────────────────────────────────────────────

var pgConnectionEnv = [
  { name: 'PGHOST', value: postgres.outputs.fqdn }
  { name: 'PGSSLMODE', value: 'require' }
]

module bootstrapJob 'modules/db-job.bicep' = if (deployJobs) {
  name: 'job-db-bootstrap'
  params: {
    location: location
    name: take('${base}-db-bootstrap', 32)
    tags: tags
    environmentId: containerEnv.outputs.id
    identityId: bootstrapIdentity.outputs.id
    registryServer: registryServer
    image: '${registryServer}/inventra/db-tools:${imageTag}'
    args: ['bootstrap']
    keyVaultSecrets: concat(
      [{ name: 'admin-password', keyVaultUrl: '${secretUrl}${secretNames.postgresAdmin}' }],
      map(range(0, length(services)), i => { name: '${services[i].name}-runtime', keyVaultUrl: '${secretUrl}${secretNames.runtimePassword[i]}' }),
      map(range(0, length(services)), i => { name: '${services[i].name}-migrator', keyVaultUrl: '${secretUrl}${secretNames.migratorPassword[i]}' })
    )
    env: concat(
      pgConnectionEnv,
      [
        { name: 'PGDATABASE', value: 'postgres' }
        { name: 'PGUSER', value: postgresAdminLogin }
        { name: 'PGPASSWORD', secretRef: 'admin-password' }
        // "service=database" pairs, one per service.
        { name: 'INVENTRA_DATABASES', value: join(map(services, s => '${s.name}=${s.database}'), ' ') }
      ],
      map(services, s => { name: 'PG_${toUpper(replace(s.name, '-', '_'))}_RUNTIME_PASSWORD', secretRef: '${s.name}-runtime' }),
      map(services, s => { name: 'PG_${toUpper(replace(s.name, '-', '_'))}_MIGRATOR_PASSWORD', secretRef: '${s.name}-migrator' })
    )
  }
}

module migrateJobs 'modules/db-job.bicep' = [
  for (s, i) in services: if (deployJobs) {
    name: 'job-migrate-${s.name}'
    params: {
      location: location
      name: take('${base}-migrate-${s.name}', 32)
      tags: tags
      environmentId: containerEnv.outputs.id
      identityId: migratorIdentities[i].outputs.id
      registryServer: registryServer
      image: '${registryServer}/inventra/db-tools:${imageTag}'
      args: ['migrate', s.name]
      keyVaultSecrets: [{ name: 'migrator-password', keyVaultUrl: '${secretUrl}${secretNames.migratorPassword[i]}' }]
      env: concat(pgConnectionEnv, [
        { name: 'PGDATABASE', value: s.database }
        { name: 'PGUSER', value: logins.migrator[i] }
        { name: 'PGPASSWORD', secretRef: 'migrator-password' }
      ])
    }
  }
]

// ── Stage 3: apps ─────────────────────────────────────────────────────────────────────────────────────

var authEnv = concat(
  empty(platformAuthority) ? [] : [
    { name: 'Auth__Platform__Authority', value: platformAuthority }
    { name: 'Auth__Platform__Audience', value: platformAudience }
  ],
  empty(tenantAuthority) ? [] : [
    { name: 'Auth__Tenant__Authority', value: tenantAuthority }
    { name: 'Auth__Tenant__Audience', value: tenantAudience }
  ]
)

module serviceApps 'modules/container-app.bicep' = [
  for (s, i) in services: if (deployApps) {
    name: 'app-${s.name}'
    params: {
      location: location
      name: appName[i]
      tags: tags
      environmentId: containerEnv.outputs.id
      identityId: serviceIdentities[i].outputs.id
      registryServer: registryServer
      image: '${registryServer}/inventra/${s.name}:${imageTag}'
      external: false
      minReplicas: size.minReplicas
      maxReplicas: size.maxReplicas
      keyVaultSecrets: [{ name: 'db-connection', keyVaultUrl: '${secretUrl}${secretNames.runtimeConnection[i]}' }]
      env: concat(authEnv, [
        { name: 'ASPNETCORE_ENVIRONMENT', value: aspnetEnvironment }
        { name: 'OTEL_SERVICE_NAME', value: s.name }
        { name: 'ConnectionStrings__${s.database}', secretRef: 'db-connection' }
        { name: 'Database__MigrateOnStartup', value: 'false' } // Migrations run as a job before the apps update.
        { name: 'Database__MaxPoolSize', value: '10' }
        { name: 'AZURE_CLIENT_ID', value: serviceIdentities[i].outputs.clientId } // For DefaultAzureCredential.
        { name: 'ServiceBus__FullyQualifiedNamespace', value: serviceBus.outputs.fullyQualifiedNamespace }
      ], s.usesBlobStorage ? [{ name: 'Storage__BlobEndpoint', value: storage.outputs.blobEndpoint }] : [])
    }
    dependsOn: [migrateJobs]
  }
]

module gatewayApp 'modules/container-app.bicep' = if (deployApps) {
  name: 'app-${gatewayName}'
  params: {
    location: location
    name: gatewayAppName
    tags: tags
    environmentId: containerEnv.outputs.id
    identityId: gatewayIdentity.outputs.id
    registryServer: registryServer
    image: '${registryServer}/inventra/${gatewayName}:${imageTag}'
    external: true
    minReplicas: size.minReplicas
    maxReplicas: size.maxReplicas
    env: concat(
      authEnv,
      [
        { name: 'ASPNETCORE_ENVIRONMENT', value: aspnetEnvironment }
        { name: 'OTEL_SERVICE_NAME', value: gatewayName }
        { name: 'ASPNETCORE_FORWARDEDHEADERS_ENABLED', value: 'true' }
        { name: 'AZURE_CLIENT_ID', value: gatewayIdentity.outputs.clientId }
      ],
      // Service discovery: "https+http://tenancy" in the gateway's routes resolves to the internal app.
      map(range(0, length(services)), i => { name: 'services__${services[i].name}__http__0', value: 'http://${appName[i]}' }),
      map(range(0, length(allCorsOrigins)), i => { name: 'Cors__Origins__${i}', value: allCorsOrigins[i] })
    )
  }
  dependsOn: [serviceApps]
}

// ── Outputs (names only; never secrets) ───────────────────────────────────────────────────────────────

output keyVaultName string = keyVault.outputs.name
output registryName string = registry.outputs.name
output registryLoginServer string = registryServer
output containerAppsEnvironmentName string = containerEnv.outputs.name
output postgresServerName string = postgres.outputs.name
output bootstrapJobName string = take('${base}-db-bootstrap', 32)
output migrateJobNames array = map(services, s => take('${base}-migrate-${s.name}', 32))
output gatewayUrl string = deployApps ? 'https://${gatewayApp!.outputs.fqdn}' : ''
output webApps array = staticSites.outputs.sites
output secretNamesToEnsure array = concat([secretNames.postgresAdmin], secretNames.runtimePassword, secretNames.migratorPassword)
