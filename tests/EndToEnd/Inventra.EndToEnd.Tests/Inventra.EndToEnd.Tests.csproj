<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end tests: start the whole platform through the AppHost (Aspire.Hosting.Testing) and drive
    the admin console in a real browser (Playwright). Needs Docker, Node 22 and the Playwright browser.
    Not part of Inventra.slnx, so "dotnet test Inventra.slnx" stays fast. See docs/qa/end-to-end.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AppHost\Inventra.AppHost\Inventra.AppHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
    <Using Include="Microsoft.Playwright.Assertions" Static="true" />
  </ItemGroup>
</Project>
