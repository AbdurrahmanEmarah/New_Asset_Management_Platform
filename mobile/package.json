{
  "name": "inventra-field",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --ci"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "0.4.2",
    "@expo-google-fonts/public-sans": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.26",
    "expo-auth-session": "58.0.19",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.14",
    "expo-font": "58.0.12",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "test-renderer": "1.3.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  }
