# Copy to .env.local and fill in. Expo reads EXPO_PUBLIC_* at build time,
# so restart `npx.cmd expo start` after changing them.

# The Keycloak realm for client users (port 18080 locally).
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:18080/realms/inventra
# A public OIDC client with PKCE, in the realm above.
EXPO_PUBLIC_AUTH_CLIENT_ID=field-app
